{
  "name": "dsh-figma-browser",
  "version": "0.1.0",
  "description": "Figma design data and true renders for DeepSeek Harness, read through the user's own signed-in Chrome without a Figma API token, paid seat, or Dev Mode.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg"
  ],
  "license": "MIT",
  "author": "Ligh7Fun",
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "figma",
    "figma-plugin-api",
    "cdp",
    "chrome-devtools-protocol",
    "design",
    "design-to-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsybindev/dsh-figma-browser.git"
  },
  "homepage": "https://github.com/tsybindev/dsh-figma-browser#readme",
  "bugs": {
    "url": "https://github.com/tsybindev/dsh-figma-browser/issues"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/cdp.js && node --check src/browser.js && node --check src/figma.js",
    "test": "node test/smoke.mjs"
  }
}
